# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → your cluster → Connect → Drivers
#
# ⚠️  IMPORTANT — Database name vs Cluster name:
#   The segment AFTER the last "/" and BEFORE "?" is the DATABASE name, not the
#   cluster name. Your cluster is typically "Cluster0" but your database (where
#   collections like "users" live) has a separate name such as "esamz".
#
#   ❌ Wrong  (cluster name used as DB name — causes "not allowed to do action [find]" errors):
#     mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/cluster0?retryWrites=true&w=majority
#
#   ✅ Correct (real database name after the slash):
#     mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/esamz?retryWrites=true&w=majority
#
# How to find your database name:
#   1. Open https://cloud.mongodb.com and go to your project.
#   2. Click "Browse Collections" on your cluster.
#   3. The name shown on the left panel (e.g. "esamz") is your DATABASE name.
#
# MongoDB Atlas user privileges required:
#   The database user in the connection string must have at least
#   "readWrite" on the database (e.g. "esamz").
#   To grant this:
#   1. Atlas Dashboard → Database Access → Edit user
#   2. Under "Database User Privileges", add a role:
#      Built-in Role = "Read and write to any database"  (or scope it to "esamz")
#   3. Save. Changes apply within ~60 seconds.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/esamz?retryWrites=true&w=majority

# ── Cashfree Payments ─────────────────────────────────────────────────────────
# Get from: https://merchant.cashfree.com → Developers → Webhooks → Secret Key
CASHFREE_SECRET_KEY=your_cashfree_webhook_secret

# ── Internal JWT Secret ───────────────────────────────────────────────────────
# Any long random string — used to sign tokens sent to the Rust backend
# Generate one with: openssl rand -base64 32
ESAMZ_MASTER_SECRET=your_random_secret_here
