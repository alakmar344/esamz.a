# ── Clerk Authentication ──────────────────────────────────────────────────────
# Get from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
# Required for account deletion (DELETE https://api.clerk.com/v1/users/{user_id})
# Same key as above — must have the "users:delete" permission in Clerk Dashboard

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → your cluster → Connect → Drivers
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/esamz
MONGODB_URI=mongodb+srv://...

# ── Internal JWT Secret ───────────────────────────────────────────────────────
# Any long random string — used to sign tokens sent to the Rust backend
# Generate one with: openssl rand -base64 32
ESAMZ_MASTER_SECRET=your_random_secret_here
